{
  "name": "qavant-pay",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && node scripts/build-functions.mjs && node scripts/migrate.mjs",
    "preview": "npm run preview -w apps/web",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:db": "TEST_DATABASE_URL=postgres://qp:qp@localhost:5433/qavant_test vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "typescript": "~6.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
